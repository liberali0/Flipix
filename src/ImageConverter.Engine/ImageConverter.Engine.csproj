<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ImageConverter.Engine</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Q16 keeps 16-bit channels exact; the package ships native codecs for win-x64 (and linux-x64 for CI). -->
    <PackageReference Include="Magick.NET-Q16-x64" Version="15.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageConverter.Engine.Tests" />
  </ItemGroup>

</Project>
