<Window x:Class="ImageConverter.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/flipix.ico"
        Title="빠른 변환 설정" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="이미지 파일을 우클릭해서 바로 변환할 때 쓰는 설정입니다. [빠른 이미지 포맷 변환] 아래에 바로 보일 형식을 고르세요. 나머지는 [자세히]에서 선택할 수 있습니다." />
        <ItemsControl x:Name="FormatList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,3" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Separator Margin="0,12" />
        <TextBlock Text="변환이 끝난 원본 파일" FontWeight="SemiBold" Margin="0,0,0,6" />
        <RadioButton x:Name="KeepOriginal" GroupName="Original" Content="그대로 남기기" Margin="0,3" />
        <RadioButton x:Name="RecycleOriginal" GroupName="Original" Content="휴지통으로 보내기" Margin="0,3" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="20,2,0,4"
                   Text="변환에 성공한 파일만 지웁니다. 무손실 형식은 픽셀이 모두 같은지 확인한 뒤 지우고, 실패하거나 이미 같은 형식인 파일은 남깁니다. 휴지통에서 되살릴 수 있습니다." />
        <RadioButton x:Name="MoveOriginalRadio" GroupName="Original" Content="지정 폴더로 옮기기" Margin="0,3" />
        <DockPanel Margin="20,2,0,0" IsEnabled="{Binding IsChecked, ElementName=MoveOriginalRadio}">
            <Button DockPanel.Dock="Right" Content="찾아보기" Click="OnBrowseMoveFolder" Margin="6,0,0,0" Padding="10,2" />
            <TextBox x:Name="MoveFolder" />
        </DockPanel>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="20,2,0,0"
                   Text="변환에 성공한 파일만 옮깁니다. 폴더에 같은 이름이 있으면 번호를 붙여 덮어쓰지 않습니다." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="저장" Width="80" IsDefault="True" Click="OnSave" Margin="0,0,8,0" />
            <Button Content="취소" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
