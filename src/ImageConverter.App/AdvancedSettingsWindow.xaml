<Window x:Class="ImageConverter.App.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/flipix.ico"
        Title="상세 설정" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Flx.Bg}" Foreground="{DynamicResource Flx.Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Flx.Mute}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="28,0,0,6" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="상세 설정" FontSize="17" FontWeight="Bold" Margin="2,0,0,12" />

        <Border Style="{StaticResource Flx.CardPanel}" Padding="16,4,16,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Flx.Label}" Text="우클릭 빠른 변환이 끝났을 때" />
                <RadioButton x:Name="NotifyFailures" GroupName="Notify" Content="실패한 파일이 있을 때만 알리기" Margin="0,2" />
                <RadioButton x:Name="NotifyAlways" GroupName="Notify" Content="항상 알리기" Margin="0,2" />
                <TextBlock Style="{StaticResource Hint}" Text="모두 성공하면 화면 오른쪽 아래에 작은 알림이 잠깐 떴다가 사라져요." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Flx.CardPanel}" Padding="16,4,16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Flx.Label}" Text="움직이는 이미지(GIF·WEBP)를 변환할 때" />
                <RadioButton x:Name="FirstFrame" GroupName="Frames" Content="첫 프레임만" Margin="0,2" />
                <RadioButton x:Name="AllFramesRadio" GroupName="Frames" Content="모든 프레임" Margin="0,2" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="모든 프레임은 '이름_frames' 폴더에 이름_001, 이름_002… 순서로 저장해요. 첫 프레임만 변환하면 원본은 지우거나 옮기지 않고 그대로 둬요." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Flx.CardPanel}" Padding="16,4,16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Flx.Label}" Text="업데이트" />
                <CheckBox x:Name="UpdateNotices" Content="새 버전이 나오면 알려 주기" Margin="0,2" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Workshop을 열 때와 우클릭 변환을 한 뒤 하루에 한 번 확인해요. 꺼도 ⋯ 메뉴의 [업데이트 확인]으로 직접 확인할 수 있어요." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Flx.Button}" Content="취소" Width="84" IsCancel="True" />
            <Button Style="{StaticResource Flx.PrimaryButton}" Content="저장" Width="84" IsDefault="True" Click="OnSave" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
