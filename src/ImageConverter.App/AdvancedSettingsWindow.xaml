<Window x:Class="ImageConverter.App.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ImageConverter.App"
        Icon="pack://application:,,,/Assets/flipix.ico"
        Title="{l:T '상세 설정', 'Advanced settings'}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Flx.Bg}" Foreground="{DynamicResource Flx.Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Flx.Mute}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="28,0,0,6" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="{l:T '상세 설정', 'Advanced settings'}" FontSize="17" FontWeight="Bold" Margin="2,0,0,12" />

        <Border Style="{StaticResource Flx.CardPanel}" Padding="16,4,16,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Flx.Label}" Text="{l:T '우클릭 빠른 변환이 끝났을 때', 'When a right-click quick convert finishes'}" />
                <RadioButton x:Name="NotifyFailures" GroupName="Notify" Content="{l:T '실패한 파일이 있을 때만 알리기', 'Notify only when a file fails'}" Margin="0,2" />
                <RadioButton x:Name="NotifyAlways" GroupName="Notify" Content="{l:T '항상 알리기', 'Always notify'}" Margin="0,2" />
                <TextBlock Style="{StaticResource Hint}" Text="{l:T '모두 성공하면 화면 오른쪽 아래에 작은 알림이 잠깐 떴다가 사라져요.', 'When everything succeeds, a small notice shows briefly in the lower-right corner.'}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Flx.CardPanel}" Padding="16,4,16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Flx.Label}" Text="{l:T '움직이는 이미지(GIF·WEBP)를 변환할 때', 'When converting animated images (GIF, WEBP)'}" />
                <RadioButton x:Name="FirstFrame" GroupName="Frames" Content="{l:T '첫 프레임만', 'First frame only'}" Margin="0,2" />
                <RadioButton x:Name="AllFramesRadio" GroupName="Frames" Content="{l:T '모든 프레임', 'All frames'}" Margin="0,2" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="{l:T '모든 프레임은 \'이름_frames\' 폴더에 이름_001, 이름_002… 순서로 저장해요. 첫 프레임만 변환하면 원본은 지우거나 옮기지 않고 그대로 둬요.', 'All frames are saved in a \'name_frames\' folder as name_001, name_002, and so on. When only the first frame is converted, the original is kept and not removed or moved.'}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Flx.CardPanel}" Padding="16,4,16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Flx.Label}" Text="{l:T '업데이트', 'Updates'}" />
                <CheckBox x:Name="UpdateNotices" Content="{l:T '새 버전이 나오면 알려 주기', 'Tell me when a new version is out'}" Margin="0,2" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="{l:T 'Workshop을 열 때와 우클릭 변환을 한 뒤 하루에 한 번 확인해요. 꺼도 ⋯ 메뉴의 [업데이트 확인]으로 직접 확인할 수 있어요.', 'Checked when Workshop opens and once a day after a right-click convert. When off, you can still use [Check for updates] in the ⋯ menu.'}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Flx.CardPanel}" Padding="16,4,16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Flx.Label}" Text="화면 언어 · Language" />
                <RadioButton x:Name="LanguageAuto" GroupName="Language" Content="{l:T '자동 (Windows 설정)', 'Automatic (Windows setting)'}" Margin="0,2" />
                <RadioButton x:Name="LanguageKorean" GroupName="Language" Content="한국어" Margin="0,2" />
                <RadioButton x:Name="LanguageEnglish" GroupName="Language" Content="English" Margin="0,2" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="{l:T '우클릭 메뉴는 바로, Workshop은 다시 열면 바뀌어요.', 'The right-click menu changes right away. Workshop changes the next time you open it.'}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Flx.Button}" Content="{l:T '취소', 'Cancel'}" Width="84" IsCancel="True" />
            <Button Style="{StaticResource Flx.PrimaryButton}" Content="{l:T '저장', 'Save'}" Width="84" IsDefault="True" Click="OnSave" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
