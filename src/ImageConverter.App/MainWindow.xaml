<Window x:Class="ImageConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:batch="clr-namespace:ImageConverter.Core.Batch;assembly=ImageConverter.Core"
        Icon="pack://application:,,,/Assets/flipix.ico"
        Title="Flipix Workshop" Width="1120" Height="720" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Flx.Bg}" Foreground="{DynamicResource Flx.Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 작업 목록 한 줄 -->
        <Style x:Key="JobRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Flx.Line}"
                                BorderThickness="0,0,0,1" Padding="16,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flx.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flx.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Flx.Label}" />
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Flx.Mute}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 막대 -->
        <Border Grid.Row="0" Background="{DynamicResource Flx.Card}" BorderBrush="{DynamicResource Flx.Line}"
                BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/flipix.ico" Width="26" Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Flipix Workshop" FontSize="16" FontWeight="SemiBold" Margin="10,0,22,0"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource Flx.PrimaryButton}" Content="+  파일 추가" Command="{Binding AddFilesCommand}" />
                    <Button Style="{StaticResource Flx.Button}" Content="폴더 추가" Command="{Binding AddFolderCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Flx.Chip}" CornerRadius="7" Padding="3" Margin="0,0,10,0"
                            ToolTip="화면 테마">
                        <ListBox Style="{StaticResource Flx.PlainList}" ItemContainerStyle="{StaticResource Flx.SegmentItem}"
                                 ItemsSource="{Binding ThemeChoices}" SelectedValuePath="Value" SelectedValue="{Binding Theme}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                    <Button Style="{StaticResource Flx.GhostButton}" Content="문의하기" Command="{Binding ContactCommand}"
                            ToolTip="{Binding ContactToolTip}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 본문 -->
        <Grid Grid.Row="1" Margin="16,16,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 빠른 변환: 이 앱의 핵심이라 가장 눈에 띄게 -->
                    <Border CornerRadius="12" Padding="18,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel TextElement.Foreground="White">
                            <TextBlock Text="⚡ 빠른 변환" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="탐색기에서 이미지를 우클릭하면 바로 변환돼요" Opacity="0.85" Margin="0,3,0,12"
                                       TextWrapping="Wrap" />
                            <Border Background="#26FFFFFF" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="우클릭 ▸ 빠른 이미지 포맷 변환" FontSize="12" Opacity="0.85" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding QuickFormats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="12" Padding="10,3" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding}" Foreground="#4F46E5" FontWeight="SemiBold" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="+ 자세히" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="설정 바꾸기" Command="{Binding OpenSettingsCommand}"
                                        Style="{StaticResource Flx.Button}" Margin="10,0,0,0"
                                        Background="White" Foreground="#4F46E5" BorderBrush="White" FontWeight="SemiBold"
                                        ToolTip="우클릭 메뉴에 보일 형식과 원본 처리 방법을 바꿉니다" />
                                <TextBlock Text="{Binding QuickOriginalText}" FontSize="12" Opacity="0.9"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding QuickOriginalText}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 이 창에서 변환할 때 쓰는 설정 -->
                    <Border Style="{StaticResource Flx.CardPanel}" Padding="18,4,18,18" Margin="0,14,0,16" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="변환 형식" />
                            <ListBox Style="{StaticResource Flx.PlainList}" ItemContainerStyle="{StaticResource Flx.ChipItem}"
                                     ItemsSource="{Binding Formats}" SelectedValuePath="Id" SelectedValue="{Binding TargetFormatId}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource Flx.Warn}"
                                       Text="JPG는 손실 압축이라 품질 100으로 저장해도 원본과 완전히 같지 않을 수 있어요."
                                       Visibility="{Binding LossyWarning, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="저장 위치" />
                            <ComboBox ItemsSource="{Binding SaveLocationChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding UseCustomFolder}" />
                            <StackPanel Visibility="{Binding UseCustomFolder, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Flx.Button}" Content="찾기"
                                            Command="{Binding BrowseOutputCommand}" Margin="6,0,0,0" Padding="12,5" />
                                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                </DockPanel>
                                <CheckBox Content="폴더로 추가한 파일은 하위 폴더 구조 유지" IsChecked="{Binding PreserveStructure}" Margin="0,6,0,0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="원본 파일" />
                            <ComboBox ItemsSource="{Binding OriginalActionChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding OriginalAction}"
                                      ToolTip="변환에 성공한 원본만 처리합니다. 실패하거나 건너뛴 원본은 그대로 둡니다." />
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding MoveOriginal, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Flx.Button}" Content="찾기"
                                        Command="{Binding BrowseOriginalFolderCommand}" Margin="6,0,0,0" Padding="12,5" />
                                <TextBox Text="{Binding OriginalMoveFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                         ToolTip="원본을 옮길 폴더. 같은 이름이 있으면 번호를 붙여 덮어쓰지 않습니다." />
                            </DockPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="같은 이름이 있으면" />
                            <ComboBox ItemsSource="{Binding ConflictChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding Conflict}" />

                            <DockPanel Margin="0,14,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Parallelism}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="동시 처리" Margin="0" />
                            </DockPanel>
                            <Slider Minimum="1" Maximum="{Binding MaxParallelismLimit}" Value="{Binding Parallelism}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Style="{StaticResource Hint}" Text="128MB 이상 큰 파일은 한 번에 1개씩 처리해요." />

                            <CheckBox Content="변환 후 픽셀 검증 (느림)" IsChecked="{Binding Verify}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 작업 목록 -->
            <Border Grid.Column="2" Style="{StaticResource Flx.CardPanel}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="16,12,10,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Flx.GhostButton}" Content="실패 다시 시도" Command="{Binding RetryFailedCommand}" />
                            <Button Style="{StaticResource Flx.GhostButton}" Content="완료 지우기" Command="{Binding RemoveFinishedCommand}" />
                            <Button Style="{StaticResource Flx.GhostButton}" Content="모두 지우기" Command="{Binding ClearCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="작업 목록" FontSize="15" FontWeight="SemiBold" />
                            <Border Background="{DynamicResource Flx.Chip}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding JobCountText}" FontSize="11.5" Foreground="{DynamicResource Flx.Mute}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- 열 머리 -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Flx.Line}" BorderThickness="0,1" Padding="16,7"
                            Background="{DynamicResource Flx.Bg}">
                        <Grid TextElement.Foreground="{DynamicResource Flx.Mute}" TextElement.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="파일" />
                            <TextBlock Grid.Column="1" Text="크기" />
                            <TextBlock Grid.Column="2" Text="상태" />
                            <TextBlock Grid.Column="3" Text="진행" />
                            <TextBlock Grid.Column="4" Text="결과" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Jobs}" ItemContainerStyle="{StaticResource JobRow}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding InputPath}" Foreground="{DynamicResource Flx.Fg}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource Flx.Mute}" />
                                    <Border Grid.Column="2" x:Name="Pill" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left"
                                            Background="{DynamicResource Flx.Chip}">
                                        <TextBlock x:Name="PillText" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Flx.Mute}" />
                                    </Border>
                                    <ProgressBar Grid.Column="3" Style="{StaticResource Flx.Progress}" Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Message}" Foreground="{DynamicResource Flx.Mute}" Margin="12,0,0,0" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static batch:JobStatus.Running}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Flx.AccentSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Flx.Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static batch:JobStatus.Succeeded}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Flx.OkSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Flx.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static batch:JobStatus.Failed}">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Flx.ErrSoft}" />
                                        <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Flx.Err}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 비었을 때: 끌어다 놓기 안내 -->
                    <Border Grid.Row="2" Margin="16" CornerRadius="10" BorderThickness="0" IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource Flx.Line}" StrokeThickness="2"
                                       StrokeDashArray="4 3" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⇩" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource Flx.Accent}" />
                                <TextBlock Text="이미지 파일이나 폴더를 여기에 끌어다 놓으세요" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,6,0,4" />
                                <TextBlock Text="폴더는 하위 폴더까지 모두 찾아요" Foreground="{DynamicResource Flx.Mute}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 하단: 전체 진행과 실행 -->
        <Border Grid.Row="2" Background="{DynamicResource Flx.Card}" BorderBrush="{DynamicResource Flx.Line}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Style="{StaticResource Flx.Button}" Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" />
                    <Button Style="{StaticResource Flx.Button}" Content="취소" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource Flx.PrimaryButton}" Content="변환 시작" Command="{Binding StartCommand}"
                            Padding="26,8" Margin="0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource Flx.Progress}" Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding OverallProgress, Mode=OneWay}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Flx.Mute}" Margin="0,6,0,0" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
