<Window x:Class="ImageConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/flipix.ico"
        Title="Flipix - 전문 모드" Width="1020" Height="680" MinWidth="820" MinHeight="520"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 목록 도구 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="빠른 변환 설정" Command="{Binding OpenSettingsCommand}" Margin="0"
                    ToolTip="이미지를 우클릭해서 바로 변환할 때 쓰는 설정" />
            <Button DockPanel.Dock="Right" Content="문의하기" Command="{Binding ContactCommand}"
                    ToolTip="{Binding ContactToolTip}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="파일 추가" Command="{Binding AddFilesCommand}" />
                <Button Content="폴더 추가" Command="{Binding AddFolderCommand}" />
                <Button Content="완료 항목 제거" Command="{Binding RemoveFinishedCommand}" />
                <Button Content="실패 항목 다시 시도" Command="{Binding RetryFailedCommand}" />
                <Button Content="목록 비우기" Command="{Binding ClearCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- 변환 옵션 -->
        <GroupBox Grid.Row="1" Header="변환 설정" Padding="8" Margin="0,0,0,10" IsEnabled="{Binding IsIdle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="변환 형식" VerticalAlignment="Center" Margin="0,0,12,6" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox Width="180" ItemsSource="{Binding Formats}" DisplayMemberPath="Display"
                              SelectedValuePath="Id" SelectedValue="{Binding TargetFormatId}" />
                    <TextBlock Text="JPG는 손실 압축 포맷입니다. 품질 100으로 저장하지만 원본과 완전히 같지는 않을 수 있습니다."
                               Foreground="#B45309" Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding LossyWarning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="저장 위치" VerticalAlignment="Center" Margin="0,0,12,6" />
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Left" Content="지정 폴더에 저장" IsChecked="{Binding UseCustomFolder}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseOutputCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomFolder}" />
                </DockPanel>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="폴더로 추가한 파일은 하위 폴더 구조를 유지" Margin="0,0,0,6"
                          IsChecked="{Binding PreserveStructure}" IsEnabled="{Binding UseCustomFolder}" />

                <TextBlock Grid.Row="3" Text="원본 파일" VerticalAlignment="Center" Margin="0,0,12,6" />
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                    <ComboBox DockPanel.Dock="Left" Width="170" ItemsSource="{Binding OriginalActionChoices}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding OriginalAction}" Margin="0,0,10,0"
                              ToolTip="변환에 성공한 원본만 처리합니다. 실패하거나 건너뛴 원본은 그대로 둡니다." />
                    <Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseOriginalFolderCommand}" Margin="6,0,0,0"
                            IsEnabled="{Binding MoveOriginal}" />
                    <TextBox Text="{Binding OriginalMoveFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MoveOriginal}"
                             ToolTip="원본을 옮길 폴더. 같은 이름이 있으면 번호를 붙여 덮어쓰지 않습니다." />
                </DockPanel>

                <TextBlock Grid.Row="4" Text="옵션" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="같은 이름이 있으면" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="170" ItemsSource="{Binding ConflictChoices}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Conflict}" />
                    <TextBlock Text="동시 처리 수" VerticalAlignment="Center" Margin="24,0,6,0" />
                    <Slider Width="140" Minimum="1" Maximum="{Binding MaxParallelismLimit}" Value="{Binding Parallelism}"
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Parallelism}" Width="24" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="(128MB 이상 대용량 파일은 한 번에 1개씩 처리)" Foreground="Gray" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <CheckBox Content="변환 후 픽셀 검증(느림)" IsChecked="{Binding Verify}" Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 작업 목록 -->
        <Grid Grid.Row="2">
            <ListView ItemsSource="{Binding Jobs}" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="False">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="파일" Width="300" DisplayMemberBinding="{Binding FileName}" />
                        <GridViewColumn Header="크기" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="상태" Width="80" DisplayMemberBinding="{Binding StatusText}" />
                        <GridViewColumn Header="진행" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Minimum="0" Maximum="100" Height="12" Width="130" Value="{Binding Progress, Mode=OneWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="결과 / 오류" Width="320" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False"
                    Margin="0,28,0,0" Background="#08000000">
                <TextBlock Text="여기에 이미지 파일이나 폴더를 끌어다 놓으세요&#x0A;(폴더는 하위 폴더까지 모두 찾습니다)"
                           TextAlignment="Center" FontSize="16" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- 실행 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="시작" Command="{Binding StartCommand}" FontWeight="Bold" Padding="22,5" />
                <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" />
                <Button Content="취소" Command="{Binding CancelCommand}" Margin="0" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <ProgressBar Minimum="0" Maximum="100" Height="14" Value="{Binding OverallProgress, Mode=OneWay}" />
                <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
