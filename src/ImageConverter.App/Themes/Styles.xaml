<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flipix Workshop 공통 스타일. 색은 모두 DynamicResource라 테마를 바꾸면 바로 따라간다. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- 버튼: 기본(테두리), 강조(인디고), 고스트(글자만) -->
    <Style x:Key="Flx.Button" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Flx.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Flx.Fg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Flx.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flx.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Flx.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Flx.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Flx.Button}">
        <Setter Property="Background" Value="{DynamicResource Flx.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Flx.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Flx.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flx.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Flx.GhostButton" TargetType="Button" BasedOn="{StaticResource Flx.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Flx.Mute}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- 카드 -->
    <Style x:Key="Flx.CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Flx.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Flx.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- 카드 안 소제목 -->
    <Style x:Key="Flx.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Flx.Mute}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <!-- 변환 형식 칩: ListBox 항목을 알약 모양 버튼처럼 -->
    <Style x:Key="Flx.ChipItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="14" Padding="12,5" Background="{DynamicResource Flx.Chip}">
                        <TextBlock x:Name="Tx" Text="{Binding Display}" FontWeight="SemiBold" Foreground="{DynamicResource Flx.Fg}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flx.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flx.Accent}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Flx.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 테마 고르기(시스템/라이트/다크) 세그먼트 -->
    <Style x:Key="Flx.SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="5" Padding="10,4" Background="Transparent">
                        <TextBlock x:Name="Tx" Text="{Binding Label}" Foreground="{DynamicResource Flx.Mute}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Flx.Card}" />
                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Flx.Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 칩·세그먼트를 담는 ListBox: 기본 테두리와 선택 배경을 없앤다 -->
    <Style x:Key="Flx.PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 얇은 진행 막대 -->
    <Style x:Key="Flx.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Foreground" Value="{DynamicResource Flx.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Flx.Line}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
