<?xml version="1.0" encoding="utf-8"?>
<!-- 패키지는 nuget.org에서만 받습니다. PC나 빌드 서버에 다른 패키지 저장소가 설정돼 있어도
     같은 이름의 가짜 패키지가 끼어들 수 없도록(의존성 혼동 공격) 출처를 고정합니다. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
